<?xml version="1.0" encoding="utf-8"?>
<!--
  MonoIcon foreground: the app-icon-frame glyph.

  A rounded-SQUARE app-icon frame (ring) with a filled circle in its centre: the
  square is the original colourful app icon, the circle is the single-colour
  themed icon MonoIcon produces from it.

  Geometry rules this file must keep satisfying:
  - the glyph is square and centered: 58x58 spanning x/y 25..83, inside the
    centered 66x66dp adaptive-icon safe zone, so no mask - squircle, circle or
    rounded square - clips it;
  - the ring is an evenOdd hole, which DOES render transparent, so a themed-icon
    build samples the background colour through it. With the dark background the
    glyph therefore keeps high contrast in both the normal and the themed
    rendering;
  - the ring is 11 units thick everywhere (34-25 = 74-63 = 11, and 36-25 = 72-63
    = 11 on the vertical), which is what keeps it legible down to a 24dp cell;
  - the corners nest: outer radius 18, inner radius 4, and inner + ring thickness
    (4 + 11 = 15) stays below the outer radius, so the ring never pinches to zero.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- App-icon frame: 58x58 rounded square, 11-unit ring, 18/4-unit corners. -->
    <path
        android:fillColor="#EEF1FA"
        android:fillType="evenOdd"
        android:pathData="M43,25 L65,25 A18,18 0 0 1 83,43 L83,65 A18,18 0 0 1 65,83 L43,83 A18,18 0 0 1 25,65 L25,43 A18,18 0 0 1 43,25 Z M38,36 L70,36 A4,4 0 0 1 74,40 L74,68 A4,4 0 0 1 70,72 L38,72 A4,4 0 0 1 34,68 L34,40 A4,4 0 0 1 38,36 Z" />

    <!-- Themed result: one flat circle, the shape the pipeline actually emits. -->
    <path
        android:fillColor="#EEF1FA"
        android:pathData="M54,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0 Z" />
</vector>
