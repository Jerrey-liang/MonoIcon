<?xml version="1.0" encoding="utf-8"?>
<!--
  MonoIcon icon background: a flat dark plate.

  Flat on purpose (no gradient, no grid): the glyph is a thin ring plus a dot, so
  the background has to stay quiet for the silhouette to carry, and a themed-icon
  build samples this colour straight through the ring's transparent hole.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#1F2433"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
</vector>
