<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fallback path for the in-app "Restart HyperOS Launcher" button -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!--
      Read the wallpaper IMAGE so the theme seed can be quantised the way Material
      Color Utilities defines it (Celebi quantise + Score ranking). Without it we
      can only read WallpaperManager's already-reduced primary/secondary/tertiary
      trio, which yields a different - and typically washed-out - colour: on the
      reference wallpaper the framework reports #A592D3 while the quantised seed is
      #706496.

      signature|privileged permission, so it has to be granted explicitly
      (LSPosed Manager / App Ops / root). Without the grant the engine falls back to
      the framework colours and the palette stays approximate.
    -->
    <uses-permission
        android:name="android.permission.READ_WALLPAPER_INTERNAL"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonoIcon"
        tools:targetApi="36">

        <!-- LSPosed 模块标识 metadata（必需：LSPosed Manager 通过它识别模块） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Convert HyperOS app icons to monochrome Material You themed icons" />
        <meta-data
            android:name="xposedminversion"
            android:value="101" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- libxposed 模块初始化 ContentProvider（框架提供，处理 SEND_BINDER） -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.jerrey.monoicon.XposedService"
            android:exported="true"
            android:enabled="true" />
        <meta-data
            android:name="de.robv.android.xposed.category.MODULE_SETTINGS"
            android:value="com.jerrey.monoicon.MainActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MonoIcon">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
