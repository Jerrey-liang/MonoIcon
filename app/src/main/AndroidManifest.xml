    <!--
      Read the wallpaper IMAGE so the theme seed can be quantised the way Material
      Color Utilities defines it (Celebi quantise + Score ranking). Without it we
      can only read WallpaperManager's already-reduced primary/secondary/tertiary
      trio, which yields a different - and typically washed-out - colour: on the
      reference wallpaper the framework reports #A592D3 while the quantised seed is
      #706496.

      When direct image access is unavailable, the module reads the current
      user's home wallpaper through Root. All palettes are calculated from
      that image; system-provided WallpaperColors are never used as a seed.
    -->
    <uses-permission
        android:name="android.permission.READ_WALLPAPER_INTERNAL"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".MonoIconApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonoIcon"
        tools:targetApi="36">

        <!-- Read-only wallpaper bridge; the provider verifies same-user module,
             launcher and SystemUI callers before opening its fixed snapshot. -->
        <provider
            android:name=".theme.wallpaper.WallpaperSnapshotProvider"
            android:authorities="${applicationId}.wallpaper.snapshot"
            android:exported="true" />

        <!-- Reports are accepted only from the module and verified same-user hook hosts. -->
        <provider
            android:name=".hook.HookDiagnosticsProvider"
            android:authorities="${applicationId}.hook.diagnostics"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_share_paths" />
        </provider>

        <!-- LSPosed 模块标识 metadata（必需：LSPosed Manager 通过它识别模块） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Convert HyperOS app icons to monochrome Material You themed icons" />
        <meta-data
            android:name="xposedminversion"
            android:value="101" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- libxposed 模块初始化 ContentProvider（框架提供，处理 SEND_BINDER） -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.jerrey.monoicon.XposedService"
            android:exported="true"
            android:enabled="true" />
        <meta-data
            android:name="de.robv.android.xposed.category.MODULE_SETTINGS"
            android:value="com.jerrey.monoicon.MainActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MonoIcon">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <receiver
            android:name=".hook.HyperOs4RefreshReceiver"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE" />
        <service
            android:name=".hook.HyperOs4ThemeJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".hook.HyperOs4RefreshJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
